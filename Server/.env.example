# Copy this file to ".env" in the SAME folder (Server) and fill in values.
# Never commit .env — it is gitignored.

# Atlas (paste your full URI from Atlas Connect), or local: mongodb://127.0.0.1:27017/syncdev
MONGODB_URI=mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_CLUSTER_HOST/syncdev?retryWrites=true&w=majority
JWT_SECRET=change_me_to_a_long_random_string

# GitHub OAuth (Developer settings → OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/github/callback
CLIENT_ORIGIN=http://localhost:5173

# Optional
# PORT=3000
# EMPTY_ROOM_GRACE_MS=120000
# GOOGLE_CLIENT_ID=

# GitHub import / push (defaults: 5000 files, 2MB each; commit up to 8000 paths per request)
# GITHUB_IMPORT_MAX_FILES=5000
# GITHUB_IMPORT_MAX_FILE_BYTES=2097152
# GITHUB_COMMIT_MAX_FILES=8000

# JS/TS sandbox (Run panel) — max execution time in ms
# EXECUTE_TIMEOUT_MS=8000
