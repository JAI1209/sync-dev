PORT=4000

# Linux/macOS/WSL2 (default):
DOCKER_SOCKET=/var/run/docker.sock

# Windows — named pipe (no Docker Desktop setting needed):
# DOCKER_SOCKET=//./pipe/docker_engine

# Windows — TCP (enable in Docker Desktop > Settings > General > "Expose daemon on tcp://localhost:2375"):
# DOCKER_SOCKET=tcp://localhost:2375

EXEC_SERVICE_SECRET=change-me-in-production
CONTAINER_MEMORY_MB=256
CONTAINER_CPU_QUOTA=50000
CONTAINER_TIMEOUT_MS=30000
CONTAINER_IDLE_TTL_MS=300000
